rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regras padrão para as coleções do Tadra MVP
    match /{document=**} {
      // Qualquer usuário logado no app pode ler (necessário para o app final)
      allow read: if request.auth != null;
      
      // Apenas o Administrador (seu UID) pode criar, editar ou deletar itens
      allow write: if request.auth != null && request.auth.uid == 'NQglP9uMWUSi9cmgGjJut6YOTzs1';
    }
  }
}
